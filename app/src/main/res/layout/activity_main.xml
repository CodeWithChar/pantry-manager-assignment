<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bone">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/cafe_noir"
        android:padding="16dp"
        android:gravity="center"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textEmptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Your pantry is empty. Tap + to add an ingredient."
        android:textSize="16sp"
        android:textColor="@color/light_grey_text"
        android:visibility="gone" />

    <Button
        android:id="@+id/buttonAddItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="+ Add Ingredient"
        android:backgroundTint="@color/raw_umber"
        android:textColor="@color/white"
        android:padding="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/drab_dark_brown">

        <Button
            android:id="@+id/buttonNavPantry"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pantry"
            android:backgroundTint="@color/kombu_green"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/buttonNavRecipes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Recipes"
            android:backgroundTint="@color/drab_dark_brown"
            android:textColor="@color/bone" />

        <Button
            android:id="@+id/buttonNavSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:backgroundTint="@color/drab_dark_brown"
            android:textColor="@color/bone" />

    </LinearLayout>

</LinearLayout>